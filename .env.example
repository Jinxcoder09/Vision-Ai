# ════════════════════════════════════════════════════════════════════
# Eyeva AI V1 – Environment Variables
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.
# ════════════════════════════════════════════════════════════════════

# ── NVIDIA NIM API ────────────────────────────────────────────────────────────
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: if you have a separate Qwen API key, set it here.
# If empty, NVIDIA_API_KEY is used for all VLM calls.
QWEN_API_KEY=

# ── Vision Model ──────────────────────────────────────────────────────────────
# Available NVIDIA NIM vision models (check https://build.nvidia.com/models):
#   qwen/qwen2.5-vl-7b-instruct
#   qwen/qwen2.5-vl-72b-instruct
#   nvidia/llama-3.2-11b-vision-instruct
VLM_MODEL=qwen/qwen2.5-vl-7b-instruct
VLM_MAX_TOKENS=200

# ── Faster Whisper (STT) ──────────────────────────────────────────────────────
# Model size: tiny.en | base.en | small.en | medium.en | large-v3
# Larger = more accurate but slower
WHISPER_MODEL=base.en
# Device: cpu | cuda | auto
WHISPER_DEVICE=cpu
# Compute type: int8 | float16 | float32
WHISPER_COMPUTE_TYPE=int8

# ── Kokoro TTS ────────────────────────────────────────────────────────────────
# American English voices: af_heart | af_bella | af_nicole | af_sarah | af_sky
# American English male:   am_adam | am_michael
# British English female:  bf_emma | bf_isabella
# British English male:    bm_george | bm_lewis
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
# Language code: a=American English, b=British English
KOKORO_LANG_CODE=a

# ── PaddleOCR ─────────────────────────────────────────────────────────────────
# Default OCR language: en | hi
PADDLE_LANG=en
PADDLE_USE_GPU=false

# ── Performance Tuning ────────────────────────────────────────────────────────
# Max vision API calls per second (throttling)
MAX_FRAME_RATE=2.0
# Cache TTL in seconds (identical frame+prompt responses)
RESPONSE_CACHE_TTL=30
# LRU cache size
RESPONSE_CACHE_SIZE=128

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Comma-separated CORS origins
CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]
